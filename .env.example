# LLM Provider Configuration ("groq" or "ollama")
LLM_PROVIDER=groq

# ── Groq API Settings ────────────────────────────────────────
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Available models:
# - openai/gpt-oss-120b (High accuracy, recommended)
# - openai/gpt-oss-20b (Fast)
# - qwen/qwen3.8-27b (High reasoning)

# ── Ollama Settings (Optional fallback) ──────────────────────
OLLAMA_MODEL=phi3
OLLAMA_BASE_URL=http://localhost:11434

# ── Agent Parameters ─────────────────────────────────────────
TEMPERATURE=0.1
MAX_TOKENS=1024
